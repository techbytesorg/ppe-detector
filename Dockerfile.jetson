# Dockerfile for NVIDIA Jetson devices (ARM64)
# Based on JetPack with CUDA support
FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0

# Set working directory
WORKDIR /app

# Update package lists and install system dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libglib2.0-0 \
    libgtk-3-0 \
    libgl1-mesa-glx \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    libgstreamer-plugins-base1.0-0 \
    libgstrtspserver-1.0-0 \
    gstreamer1.0-rtsp \
    v4l-utils \
    wget \
    curl \
    git \
    build-essential \
    cmake \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install OpenCV with GStreamer support for Jetson
RUN pip3 install opencv-python==4.8.1.78

# Copy requirements and filter out packages that conflict with Jetson
COPY requirements.txt requirements_original.txt

# Create Jetson-specific requirements (exclude torch, torchvision as they're pre-installed)
RUN grep -v "torch" requirements_original.txt | \
    grep -v "torchvision" | \
    grep -v "opencv-python" > requirements_jetson.txt

# Install remaining Python dependencies
RUN pip3 install --no-cache-dir -r requirements_jetson.txt

# Install ultralytics with Jetson optimizations
RUN pip3 install ultralytics

# Copy the application code
COPY . .

# Create necessary directories
RUN mkdir -p input_files output_files models results

# Set proper permissions
RUN chmod +x main.py

# Install additional Jetson-specific packages
RUN pip3 install jetson-stats

# Set CUDA environment for Jetson
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PATH=$CUDA_HOME/bin:$PATH

# Add Jetson hardware optimization flags
ENV OPENCV_DNN_BACKEND=CUDA
ENV OPENCV_DNN_TARGET=CUDA

# Expose port for potential web interface
EXPOSE 8000

# Health check adapted for Jetson
HEALTHCHECK --interval=30s --timeout=15s --start-period=10s --retries=3 \
    CMD python3 -c "import cv2, torch; print(f'OpenCV: {cv2.__version__}, PyTorch: {torch.__version__}, CUDA available: {torch.cuda.is_available()}')" || exit 1

# Default command
CMD ["python3", "main.py"]